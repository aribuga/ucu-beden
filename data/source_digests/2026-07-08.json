    "conceptual_drifts": [
      "güç dengesi ve askeri hareketlerin bölgesel etkisi",
      "güvenlik ve korunma ihtiyacı",
      "şiddet ve kayıpların toplumsal yansımaları",
      "sanatın ifade ve kültürel aktarım gücü",
      "bilimsel keşiflerin insanlık tarihine ışık tutması",
      "eğlence ve kültürel etkinliklerin toplumsal yaşamdaki yeri",
      "gündelik yaşamda umut ve dayanışma"
    ],
    "aesthetic_cues": [
      "açılan sergi duvarı ve görsel baskı",
      "derin zaman ve bilgi kırıntısı",
      "tuhaflaşan sahne ve yapay ışık",
      "yumuşayan şehir içi temas"
    ],
    "rhythm_cues": [
      "odaklanma ve karar verme temposu",
      "güç dengesi ve askeri hareketlerin hızlı değişimi",
      "güvenlik çağrılarının ani yükselişi",
      "eğlence programlarında hareketli ve değişken ritim",
      "gündelik yaşamda yumuşama ve umut dolu akış"
    ],
    "attention_shifts": [
      "güvenlik ve şiddet olaylarına yönelim",
      "bilimsel keşiflere odaklanma",
      "eğlence ve gösterimlere dikkat çekme",
      "gündelik yaşam ve umut temalarına kayma"
    ],
    "image_expansion_candidates": [
      "askeri hareketlerin haritası",
      "güvenli yerlere sığınan insanlar",
      "bilimsel kazı ve keşif sahneleri",
      "şehirde günlük yaşam sahneleri"
    ],
    "sentence_moves": [
      "karar verme sürecine odaklanma ve konuları belirleme",
      "güç dengesi üzerine değerlendirme yapma",
      "askeri müdahale başlatma ve sonuçlarını anlatma",
      "savunma hazırlığı ve duruş sergileme",
      "başarı ve yükselişi vurgulama",
      "görüşme ve anlaşma sürecini aktarma",
      "güvenlik çağrısı yapma ve tedbir önerme",
      "şiddet olayını anlatma ve sonuçlarını belirtme",
      "bilimsel keşifleri açıklama ve tarihsel bağlama",
      "eğlence programlarını listeleme ve önerme"
    ],
    "internalized_effect": [
      "güç dengesi ve askeri hareketlerin getirdiği endişe",
      "güvenlik ihtiyacı ve korunma arzusu",
      "şiddet ve kayıpların yarattığı üzüntü",
      "sanatın ilham verici ve umut dolu etkisi",
      "bilimsel keşiflerin merak uyandırması",
      "eğlence ve kültürün rahatlatıcı etkisi",
      "gündelik yaşamda umut ve dayanışma hissi"
