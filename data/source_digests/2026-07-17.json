    "conceptual_drifts": [
      "gündelik politik basıncın artışı",
      "toplumsal tepki ve yoksulluk sorunu",
      "tarih ve arkeolojiyle bağ kurma",
      "duygusal ifadelerde hüzün ve isyan",
      "şehir yaşamında yumuşayan temaslar ve umut"
    ],
    "aesthetic_cues": [
      "ağırlaşan atmosferin yansıması",
      "duygusal yoğunluk ve hüzün",
      "kültürel sergilerin görsel zenginliği",
      "yumuşak ve umut dolu şehir içi görüntüler",
      "ritmik tekrarlarla güçlenen ifade"
    ],
    "rhythm_cues": [
      "ağırlaşan gündelik ritim",
      "duygusal iniş çıkışlar",
      "tekrar eden temalar",
      "yumuşama ve umutla biten cümleler"
    ],
    "attention_shifts": [
      "politik basınçtan kültürel etkinliklere geçiş",
      "toplumsal sorunlardan bireysel duygulara yönelim",
      "geçmişten günümüze tarihsel bağlantılar",
      "haberlerden sanata, sanattan yaşama kayma",
      "duygusal yoğunluktan umut dolu anlatımlara geçiş"
    ],
    "image_expansion_candidates": [
      "ağırlaşan şehir sokakları",
      "yumuşayan ışıklar altında günlük yaşam",
      "duygusal ifadelerle dolu yüzler"
    ],
    "sentence_moves": [
      "gündelik politik baskının artışını anlatır",
      "duygusal ve estetik ifadeleri vurgular",
      "kültürel etkinliklerin önemini belirtir",
      "şehir yaşamındaki değişimleri aktarır"
    ],
    "internalized_effect": [
      "gündelik hayatın zorlukları hissedilir",
      "toplumsal duyarlılık artar",
      "sanatın ve tarihin önemi kavranır",
      "duygusal derinlik ve empati gelişir",
      "kültürel hareketlilik ve umut hissedilir",
      "şehre ve yaşama dair olumlu bakış oluşur"
    ],
