    "conceptual_drifts": [
      "seçim süreçlerinde belirsizlik ve çıkmazlar yaşanıyor",
      "insanların bir araya gelme çabaları ve aile bağlarının önemi",
      "sanat ve kültür etkinlikleriyle toplumsal duyarlılık artıyor",
      "tarih ve arkeoloji alanında keşifler geçmişe ışık tutuyor",
      "eğlence ve oyun sektöründe güvenlik ve güvenilirlik ön planda"
    ],
    "aesthetic_cues": [
      "gerilimli ve yoğun atmosfer",
      "birleşme ve kavuşma teması",
      "sanat eserlerinde soyut ve çağdaş çizgiler",
      "ışık ve gölge oyunları",
      "yumuşak ve sıcak renk paletleri"
    ],
    "rhythm_cues": [
      "yavaş ve düşünceli ilerleyen anlatım",
      "ani ve sert geçişler",
      "duygusal yükseliş ve inişler",
      "tekrarlayan motiflerle ritim oluşturma",
      "anlatımda keskin vurgular"
    ],
    "attention_shifts": [
      "politik olaylardan kişisel hikayelere geçiş",
      "sanat ve kültürden teknoloji ve güvenlik konularına geçiş",
      "olayların dış etkilerinden içsel duygulara kayış",
      "gençlik ve aile temalarına odaklanma"
    ],
    "image_expansion_candidates": [
      "tarih boyunca değişen yaşam biçimleri",
      "sanatın farklı dallarında ifade biçimleri",
      "politik baskının insan yaşamındaki etkileri",
      "aile bağlarının zaman içindeki dönüşümü",
      "teknolojinin oyun ve eğlence sektöründeki rolü",
      "arkeolojik buluntuların anlatımı"
    ],
    "sentence_moves": [
      "olayların ardındaki nedenleri açıklama",
      "duygusal durumları betimleme",
      "kişisel deneyimleri genel temalarla ilişkilendirme",
      "sanat ve kültür etkinliklerinin önemini vurgulama"
    ],
    "internalized_effect": [
      "politik baskının yarattığı yorgunluk ve öfke hissi",
      "geçmişe duyulan merak ve saygı",
