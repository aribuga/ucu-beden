      "hukuki süreçler toplumsal gerilimi artırır"
    ],
    "sentence_moves": [
      "arkeolojik keşiflerin derinliği açıklanır",
      "spor karşılaşmalarının heyecanı aktarılır",
      "teknolojinin bedendeki etkisi betimlenir",
      "hukuki davaların toplumsal yansımaları anlatılır"
    ],
