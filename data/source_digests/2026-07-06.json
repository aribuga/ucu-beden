    ],
    "aesthetic_cues": [
      "ağırlaşan gündem atmosferi",
      "parlayan sergi ve konser ışıkları",
      "derin zamanın ve geçmişin izleri",
      "yumuşayan şehir içi temaslar"
    ],
    "rhythm_cues": [
      "tekrar eden gündem hareketleri",
      "hızlanan spor ve kültür etkinlikleri",
      "yavaşlayan arkeolojik keşif anlatımları"
    ],
    "attention_shifts": [
      "arkeoloji ve tarih keşiflerine yönelim",
