    "conceptual_drifts": [
      "gündelik politik baskının ağırlaşması",
      "politik belirsizlik ve ertelenme",
      "toplumsal olaylarda duyarlılık ve adalet arayışı"
    ],
    "aesthetic_cues": [
      "ağırlaşan atmosferin yansıması",
      "görsel baskının etkisi",
      "derin zaman ve bilgi kırıntılarının açılması",
      "parlayan sergi ve sahne ışıkları",
      "yumuşayan şehir içi gündelik temaslar",
      "tuhaflaşan sahne ve yapay ışık"
    ],
    "rhythm_cues": [
      "yavaşlayan ve ertelenen süreçler",
      "art arda gelen politik ve sosyal haberler",
      "dönemsel kültürel hareketlilik",
      "bilgi ve keşiflerin ardışık sunumu",
      "gündelik yaşamda yumuşama ve umut"
    ],
    "attention_shifts": [
      "politik gelişmelerden kültürel etkinliklere geçiş",
      "toplumsal sorunlardan bireysel ve ailevi konulara odaklanma",
      "gündelik yaşamın yumuşaması ve umutlu beklentilere yönelme"
    ],
    "image_expansion_candidates": [
      "politik baskı altında sıkışan şehir görüntüleri",
      "kültürel etkinlik mekanlarının canlı renkleri",
      "arkeolojik kazı alanlarının detayları",
      "gündelik yaşamın yumuşak ve sıcak tonları"
    ],
    "sentence_moves": [
      "haberlerde ertelenen seçimlerin politik baskıyı artırması anlatılıyor",
      "propaganda ağının kadınları kullanması eleştiriliyor",
      "seçimlerin dönüm noktası ve kader anı olarak tanımlanması aktarılıyor",
      "yalnız yelken yarışında Türklerin varlığı vurgulanıyor",
      "suçlama ve dava sürecinde kararın çıkmaması belirtiliyor",
      "batan geminin yerinin tespiti haberi veriliyor",
      "acil durum ilan edilmesi ve etkileri anlatılıyor",
      "sergilerin açılması ve kültürel zenginlik vurgulanıyor",
      "gündelik yaşamda sanatın ve etkinliklerin yumuşatıcı etkisi anlatılıyor"
    ],
