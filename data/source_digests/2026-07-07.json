    "conceptual_drifts": [
      "spor ve kültür etkinlikleri gündelik yaşama renk katıyor",
      "toplumsal sağlık ve bireysel farkındalık artıyor"
    ],
    "aesthetic_cues": [
      "ağırlaşan atmosferin yarattığı gerilim",
      "sergi ve konserlerdeki görsel zenginlik",
      "doğa ve tarih temalarının çağrıştırdığı derinlik",
      "yumuşayan şehir içi temasların sıcaklığı"
    ],
    "rhythm_cues": [
      "spor karşılaşmalarının dinamik temposu",
      "bilimsel ve kültürel gelişmelerin düzenli ilerleyişi",
      "günlük yaşamda yavaşlayan ama sürekli devam eden hareket"
    ],
    "attention_shifts": [
      "bilimsel keşiflerden toplumsal meselelere yönelim",
      "gündemden bireysel yaşama dikkat kayması",
      "görselden işitsel ve deneyimsel algıya geçiş"
    ],
    "image_expansion_candidates": [
      "spor müsabakalarının coşkulu anları",
      "doğa ve bilim temalı görseller",
      "şehir hayatının yumuşayan dokusu"
    ],
    "sentence_moves": [
      "spor karşılaşmalarının sonucu ve etkisi aktarılıyor",
      "sağlık sorunlarının belirtileri ve etkileri açıklanıyor",
      "bilimsel gelişmelerin toplumsal yansımaları ele alınıyor"
    ],
    "internalized_effect": [
      "spor ve sanatın getirdiği umut ve canlılık",
      "bilimsel bilginin merak uyandırması",
      "toplumsal farkındalık ve duyarlılığın artması",
      "şehrin yumuşayan atmosferinde rahatlama hissi"
    ],
