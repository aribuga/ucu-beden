    ],
    "conceptual_drifts": [
      "insan ve doğa arasındaki etkileşim ve koruma",
      "tarih boyunca kültürel ve toplumsal değişimler",
      "bilimsel keşiflerin insan yaşamına etkisi",
      "etkinliklerin toplumsal bağları güçlendirmesi"
    ],
    "aesthetic_cues": [
      "parlayan ve umut veren ışıklar",
      "yumuşayan ve sıcak şehir içi görüntüler",
      "tuhaflaşan ve yapay sahne ışıkları",
      "derin zamanın ve geçmişin izleri",
      "sergi duvarlarının görsel etkisi",
      "doğanın ve bedenin estetik birlikteliği"
    ],
    "rhythm_cues": [
      "yavaş ve düşünceli ilerleyiş",
      "ani ve vurucu değişimler",
      "dalgalar halinde yükselen duygu yoğunluğu",
      "ritmik tekrarlarla güçlenen anlatım",
      "akışkan ve kesintisiz geçişler",
      "katmanlı ve çok sesli yapı",
      "durağan ve hareketli bölümlerin dengesi"
    ],
    "attention_shifts": [
      "bilimsel keşiflerden toplumsal haberlere yönelim",
      "duygusal yoğunluktan bilgi aktarımına geçiş",
      "yerel ve evrensel temalar arasında hareket",
      "gündelikten derin zamana sıçramalar"
    ],
    "image_expansion_candidates": [
      "doğanın bedenle bütünleştiği sahneler",
      "tarih öncesi ve çağdaş yaşam imgeleri",
      "şehir içi yaşamın detayları",
      "uzayın derinliklerinden gelen gizemli görüntüler",
      "insan ilişkilerinin sıcak ve dokunaklı anları",
      "festival ve etkinliklerin coşkulu atmosferi"
    ],
    "sentence_moves": [
      "gündemdeki gelişmelerin yoğunluğunu vurgulama",
      "bilimsel ve kültürel keşiflerin önemini açıklama",
      "toplumsal değişimlerin duygusal etkilerini yansıtma",
      "etkinliklerin toplumsal bağları güçlendirdiğini belirtme",
      "doğa ve insan arasındaki ilişkiyi estetik bir dille anlatma",
      "gündelik yaşamın içindeki umut ve arzuları dile getirme"
    ],
    "internalized_effect": [
      "bilginin ve sanatın verdiği açıklık ve umut",
      "doğanın ve tarihin derinliğinde hissedilen melankoli",
      "toplumsal değişimlerin getirdiği arzu ve beklenti",
      "insan ilişkilerinde güven ve sıcaklık hissi"
    ],
