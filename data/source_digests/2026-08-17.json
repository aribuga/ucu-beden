    "conceptual_drifts": [
      "politik gerilimlerin artması",
      "toplumsal kutuplaşma",
      "güvenlik ve çocuk hakları endişeleri",
      "sanatın doğa ve tarih ile buluşması",
      "arkeolojik keşiflerin geçmişe ışık tutması",
      "kültürel etkinliklerin yaygınlaşması",
      "toplumsal dayanışma ve umut arayışı"
    ],
    "aesthetic_cues": [
      "ağırlaşan politik atmosferin yarattığı gerilim",
      "doğa ve tarih temalarının estetik uyumu",
      "yumuşayan şehir içi gündelik yaşamın sıcaklığı",
      "ışık ve renk kullanımıyla yaratılan atmosfer",
      "dijital ve fiziksel alanların birleşimi"
    ],
    "rhythm_cues": [
      "haberlerin hızlı ve yoğun akışı",
      "politik tartışmaların keskin ve tekrarlayan yapısı",
      "arkeolojik keşiflerin derin zamanın yavaş ritmi",
      "toplumsal hareketlerin dalgalı temposu"
    ],
    "attention_shifts": [
      "politik haberlerden kültür ve sanata geçiş",
      "güvenlik ve çocuk hakları konularından arkeolojiye yönelim",
      "gündelik yaşamdan tarih ve bilimsel keşiflere odaklanma",
      "medya ve iletişim araçlarından fiziksel etkinliklere dikkat kayması"
    ],
    "image_expansion_candidates": [
      "politik liderlerin ve kurumların sembolik imgeleri",
      "doğa ve sanatın birleştiği açık alanlar",
      "arkeolojik buluntuların zaman derinliği",
      "şehir içi yaşamın sıcak ve samimi kareleri"
    ],
    "sentence_moves": [
      "politik gerilimlerin artışı anlatılıyor",
      "yerel yönetim değişiklikleri aktarılıyor",
      "güvenlik endişeleri dile getiriliyor",
      "arkeolojik keşiflerin önemi vurgulanıyor",
      "toplumsal dayanışma çağrısı yapılıyor"
    ],
