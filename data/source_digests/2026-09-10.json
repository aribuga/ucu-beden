    "conceptual_drifts": [
      "politik baskının artması",
      "güvenlik ve adalet sorgulamaları",
      "bilimsel keşiflerin derin zamanla bağlantısı",
      "şehir yaşamında yumuşama ve umut"
    ],
    "aesthetic_cues": [
      "karanlık ve netlik arayışı",
      "umut ve arzu duyguları",
      "melankoli ve hassasiyet",
      "parlak ve yapay ışık etkisi",
      "yumuşayan gündelik dokular"
    ],
    "rhythm_cues": [
      "yavaşlayan ve yoğunlaşan ritim",
      "kesintili ve vurgu yapan cümleler",
      "akışkan ve umutlu tonlar",
