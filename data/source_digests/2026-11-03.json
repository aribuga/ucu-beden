      "tarih",
      "oyun",
      "kumar",
      "güvenlik"
    ],
    "conceptual_drifts": [
      "gündelik politik basıncın artmasıyla duyulan yorgunluk ve öfke",
      "politik değişimlerin ve ilişkilerin etkileri",
      "doğaüstü inançların siyasete yansıması",
      "ekonomik göstergelerdeki belirsizlik",
      "kültürel etkinliklerin toplumda yarattığı umut ve arzu",
      "tarihsel keşiflerin bilgi ufkunu genişletmesi",
      "sanat ve edebiyatın farklı coğrafyaları buluşturması"
    ],
    "aesthetic_cues": [
      "ağırlaşan politik atmosferin yarattığı gerilim",
      "sergilerdeki görsel zenginlik ve çeşitlilik",
      "arkeolojik buluntuların tarihsel derinliği",
      "oyun dünyasındaki renkli ve çekici tasarımlar"
    ],
    "rhythm_cues": [
      "haberlerde artan yoğunluk ve tekrar eden temalar",
      "sanat etkinliklerinde ritmik programlar ve buluşmalar",
      "arkeolojik keşiflerde zamanın katman katman açılması",
      "oyun ve kumar tanıtımlarında akıcı ve cazip anlatım"
    ],
    "attention_shifts": [
      "politik haberlerden kültürel etkinliklere geçiş",
      "gündelik olaylardan tarihsel keşiflere yönelim",
      "sanat ve edebiyat buluşmalarına odaklanma"
    ],
    "image_expansion_candidates": [
      "politik atmosferin yoğunlaşmasıyla oluşan kasvetli şehir görüntüleri",
      "sergi salonlarının renkli ve hareketli atmosferi",
      "arkeolojik kazı alanlarının tarih kokan dokusu"
    ],
    "sentence_moves": [
      "politik haberlerde durumun karmaşıklığını ve etkilerini anlatmak için neden-sonuç ilişkileri kuruluyor",
      "kültürel etkinliklerde farklı coğrafyaların buluşması ve etkileşimi vurgulanıyor",
      "arkeolojik haberlerde geçmiş zamanın derinliği ve keşif heyecanı aktarılıyor",
      "oyun ve kumar tanıtımlarında güvenlik ve cazibe unsurları öne çıkarılıyor"
    ],
    "internalized_effect": [
      "politik haberlerin yarattığı yorgunluk ve öfke duygusu",
      "kültürel etkinliklerin umut ve arzu uyandırması",
      "tarihsel keşiflerin merak ve hayranlık duygusu",
      "oyun dünyasındaki güvenlik kaygıları ve heyecan"
    ],
