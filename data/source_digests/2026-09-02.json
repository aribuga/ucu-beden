    ],
    "conceptual_drifts": [
      "politik basıncın artması gündemi ağırlaştırıyor",
      "deniz kazaları ve kayıplar tehlikeyi artırıyor",
      "göç ve geri dönüş zorlukları yaşanıyor",
      "soruşturmalar ve tutuklamalar adalet arayışını yansıtıyor",
      "doğa ve kuşların korunması için maddi destek sağlanıyor",
      "bilimsel keşifler geçmişi aydınlatıyor ve doğruluk arayışında"
    ],
    "aesthetic_cues": [
      "gerilim ve belirsizlik hissi",
      "umut ve arayış ışığı",
      "tutkulu ve kararlı ton",
      "sanatın ve bilginin aydınlatıcı etkisi",
      "ritmik ve hareketli sahne değişimleri",
      "yumuşak ve sıcak gündelik temalar"
    ],
    "rhythm_cues": [
      "hızlı değişen gündem ve olaylar",
      "kesintili ve dalgalı duygu geçişleri",
      "sürekli artan baskı ve tepki döngüleri",
      "etkinliklerde tekrarlayan çağrılar ve buluşmalar"
    ],
    "attention_shifts": [
      "politik olaylardan kültürel etkinliklere geçiş",
      "gündemden bireysel deneyimlere yönelim",
      "tehlike ve kayıplardan umut ve korumaya kayma",
      "bilimsel doğrulama ve keşiflere odaklanma"
    ],
    "image_expansion_candidates": [
      "gemi kazası sonrası denizde kaybolanlar",
      "kuşların korunduğu doğal alanlar"
    ],
    "sentence_moves": [
      "olayların ve duyguların ardışık ve birbirine bağlı aktarımı",
      "gündemden bireysel yaşamlara geçişin yumuşak sağlanması",
      "bilgi ve duygu yoğunluğunun dengeli sunumu",
      "dikkat çekici unsurların ritmik ve tekrarlayan vurgulanması"
    ],
    "internalized_effect": [
      "gündelik hayatın ağırlaşan politik baskısı hissediliyor",
      "tehlike ve kayıpların yarattığı endişe ve hüzün",
      "umut ve arayışın güçlendirdiği direnç",
      "bireysel ve toplumsal deneyimlerin içselleştirilmesi"
    ],
