    "conceptual_drifts": [
      "politik gerilimlerin artışı",
      "doğal afetlerin yol açtığı kayıplar",
      "deniz kazalarının soru işaretleri",
      "toplumsal ifadelerin sorgulanması",
      "adalet arayışları",
      "spor karşılaşmalarının heyecanı",
      "sporcu transferlerinin etkisi",
      "tarihsel ve arkeolojik keşiflerin önemi",
      "insanlık tarihine dair bilgiler",
      "modern insanın özellikleri"
    ],
    "aesthetic_cues": [
      "melankolik ve hüzünlü tonlar",
      "açıklık ve netlik vurgusu",
      "umut ve arzu ifadeleri",
      "tuhaf ve absürt sahne betimlemeleri",
      "yumuşak ve sıcak gündelik temaslar",
      "parlayan ve canlı sergi ışıkları"
    ],
    "rhythm_cues": [
      "gündelik politik basıncın artışıyla hızlanan tempo",
      "haberlerdeki yoğun ve keskin vurgu",
      "doğa olaylarında ani ve durgun geçişler",
      "spor haberlerinde heyecanlı ve hareketli akış",
      "şehir yaşamında sakin ve yavaşlayan ritim"
    ],
    "attention_shifts": [
      "politik olaylardan doğal afetlere geçiş",
      "spor haberlerinden kültür ve sanata yönelim",
      "geçmişten günümüze tarihsel bilgi akışı",
      "bireysel ifadelerden toplumsal yansımaya kayış",
      "gündelik yaşamdan derin bilgi ve arkeolojiye dönüş"
    ],
    "image_expansion_candidates": [
      "politik gerilimlerin görünürleştiği şehir manzaraları",
      "sel ve afet sonrası doğa görüntüleri",
      "deniz kazası sonrası dalgalar ve enkaz",
      "adalet arayışını simgeleyen mahkeme salonları",
      "spor sahalarında coşkulu kalabalıklar",
      "antik eserlerin detaylı dokuları",
      "modern insanın ayak izleri",
      "şehir sokaklarında günlük yaşam kesitleri"
    ],
    "sentence_moves": [
      "duygusal atmosferi betimleyerek okuyucuyu içine çekme",
      "bilgi ve gözlemleri sade ve anlaşılır şekilde sunma",
      "soyut kavramları somut örneklerle destekleme",
      "duygu durumlarını kelimelerle ifade ederek derinleştirme"
    ],
    "internalized_effect": [
      "gündelik yaşamın karmaşıklığı ve gerilimi hissediliyor",
      "doğal afetlerin yarattığı çaresizlik duygusu",
      "adalet ve hak arayışında kararlılık",
      "tarih ve bilgiyle bağlantı kurma isteği",
      "modern yaşamın getirdiği değişimlere uyum sağlama",
      "toplumsal ilişkilerde duyulan sıcaklık ve samimiyet"
