    ],
    "conceptual_drifts": [
      "aile ve çocuk hakları",
      "görevden alma ve kriz yönetimi",
      "sosyal ilişkiler ve dışlanma",
      "spor karşılaşmaları ve yayın",
      "sanatın çağdaş yorumları ve sergiler",
      "arkeolojik keşifler ve tarih",
      "hayvan davranışlarındaki değişim",
      "çevrimiçi oyun ve güvenlik"
    ],
    "aesthetic_cues": [
      "açılan sergi ve bilgi duvarı",
      "tuhaflaşan sahne ve yapay ışık",
      "yumuşayan şehir içi gündelik temas"
    ],
    "rhythm_cues": [
      "kabaran ve yoğunlaşan duygu",
      "açılan ve genişleyen bilgi akışı",
      "tuhaf ve değişken sahne hareketi",
      "yumuşak ve umut dolu ritim"
    ],
    "attention_shifts": [
      "sosyal ilişkilerden koalisyon görüşmelerine",
      "spor etkinliklerinden sanatsal sergilere",
      "arkeolojik keşiflerden hayvan davranışlarına",
      "kültürel etkinliklerden çevrimiçi oyunlara"
    ],
    "image_expansion_candidates": [
      "adalet arayan anne figürü",
      "koalisyon görüşmelerinde ilerleme simgesi",
      "sanat eserleri ve sergi duvarları",
      "arkeolojik kalıntılar ve tarihsel objeler",
      "hayvanların davranış değişimi",
      "çevrimiçi oyun dünyası ve güvenlik"
    ],
    "sentence_moves": [
      "aile ve çocuk hakları üzerine vurgu yapma",
      "sosyal dışlanma ve arkadaş ilişkilerini ele alma",
      "koalisyon görüşmelerindeki ilerlemeyi duyurma",
      "spor karşılaşmalarının zaman ve kanal bilgisini verme",
      "sanat sergilerinin estetik ve kültürel önemini anlatma",
      "arkeolojik keşiflerin tarihsel değerini vurgulama",
      "hayvan davranışlarındaki değişimi gözlemleme",
      "çevrimiçi oyunların güvenlik ve kullanıcı deneyimini açıklama"
    ],
    "internalized_effect": [
      "adalet arayışının getirdiği hüzün ve kararlılık",
      "sanat ve kültürle gelen umut ve arzu",
      "tarih ve doğa ile bağ kurmanın getirdiği melankoli ve açıklık",
      "sosyal ilişkilerdeki karmaşıklık ve netlik",
      "teknoloji ve oyun dünyasında güven arayışı ve umut"
    ],
