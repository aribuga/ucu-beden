    "conceptual_drifts": [
      "gündelik politik basınç ve toplumsal gerilim",
      "bilimsel keşiflerle geçmişe dair aydınlanma",
      "toplumsal olaylar ve bireysel tepkiler",
      "doğa olayları ve çevresel etkiler",
      "medya ve iletişimde değişen atmosfer",
      "insanlık tarihine dair derin zaman sorgulamaları"
    ],
    "aesthetic_cues": [
      "ritmik tekrarlarla vurgulanan gerilim",
      "doğal ve kültürel motiflerin birleşimi",
      "doğal afetlerin yarattığı hareketlilik",
      "antik semboller ve çağrışımlarla derinlik"
    ],
    "rhythm_cues": [
      "sürekli artan gerilim ve yoğunluk",
      "dalgalar halinde gelen tepkiler",
      "yavaşlayan ve hızlanan anlatım temposu",
      "döngüsel tekrarlarla güçlenen tema",
      "kesintili ve akıcı geçişler",
      "yumuşayan ve sertleşen ifadeler",
      "ritmik vurgularla duygu aktarımı"
    ],
    "attention_shifts": [
      "politik olaylardan kültürel etkinliklere geçiş",
      "bireysel suçlamalardan toplumsal tepkilere kayma",
      "doğal afetlerden bilimsel keşiflere yönelme",
      "yerel haberlerden uluslararası gelişmelere geçiş",
      "geçmişten günümüze zaman atlamaları"
    ],
    "image_expansion_candidates": [
      "politik baskı ve gözaltı sahneleri",
      "orman yangını ve doğa görüntüleri",
      "şehir içi günlük yaşam kesitleri"
    ],
    "sentence_moves": [
      "olayların gelişimini özetleyerek ilerleme",
      "duygu ve tepki durumlarını betimleme",
      "zaman ve mekân değişikliklerini belirtme",
      "konu başlıklarını tanımlayıp genişletme",
      "olayların etkilerini ve sonuçlarını aktarma"
    ],
    "internalized_effect": [
