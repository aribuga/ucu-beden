    "conceptual_drifts": [
      "gündelik yaşamın zorlukları ve politik baskıların artması",
      "geçmişe dair arkeolojik ve antropolojik keşiflerin insanlık tarihine ışık tutması",
      "doğal afetlerin ve iklim değişikliğinin canlı yaşam üzerindeki etkileri",
      "toplumsal haklar ve yasal düzenlemelerin gelişimi"
    ],
    "aesthetic_cues": [
      "ritmik tekrarlarla vurgulanan mücadele ve dayanıklılık",
      "haberlerde ve raporlarda melankoli ve öfke duygularının dengelenmesi",
      "görsel ve sözel anlatımlarda derin zaman ve bilgi kırıntılarının hissedilmesi"
    ],
    "rhythm_cues": [
      "olgu raporlarında kronolojik ve mantıksal ilerleyiş",
      "duygusal tonların cümle sonlarında yoğunlaşması"
    ],
    "attention_shifts": [
      "gündemden sanata, oradan bilime ve spora geçişler",
      "olayların neden-sonuç ilişkilerine odaklanma",
      "duygu durumlarının değişimi ve çeşitlenmesi",
      "kişisel ve toplumsal boyutların iç içe geçmesi"
    ],
    "image_expansion_candidates": [
      "yangın söndürme çalışmaları",
      "politik tartışmalar ve yasa yapma süreçleri",
      "spor müsabakaları ve atletlerin hareketleri",
      "doğal afetlerin etkilediği canlılar"
    ],
    "sentence_moves": [
      "olayların gelişimini ve müdahale sürecini anlatma",
      "yasal düzenlemelerin kapsamını ve etkisini açıklama",
      "arkeolojik bulguların anlamını ve tarihsel bağlamını irdeleme",
      "duygu durumlarını ve toplumsal tepkileri yansıtma",
      "spor organizasyonlarının önemini ve katılımını vurgulama"
    ],
    "internalized_effect": [
      "okuyucuda güncel sorunlara karşı farkındalık yaratma",
      "toplumsal dayanışma ve hak arayışına duyarlılık kazandırma",
      "doğa ve insan ilişkisine dair empati oluşturma",
      "duygusal ve estetik deneyimlerle içsel zenginleşme"
    ],
