  "public_poetic_digest": {
    "safe_vocabulary_candidates": [
      "gündem",
      "politik",
      "ilişkiler",
      "saldırı",
      "ölüm",
      "yaralanma",
      "güven",
      "tepki",
      "duygu",
      "depresyon",
      "belirti",
      "fon",
