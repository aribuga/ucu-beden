      "atalar",
      "bilgi",
      "çağ",
      "sendrom",
      "mağara",
      "festival"
    ],
    "conceptual_drifts": [
      "şiddet ve saldırıların yarattığı toplumsal travma",
      "güven ve sorumluluk kavramlarının birey ve kurumlarda yansıması",
      "sanat ve kültür etkinliklerinin bilgi ve duygu aktarımı",
      "geçmişten günümüze insanlık tarihi ve biyolojik gelişim",
      "psikolojik durumların günlük yaşamdaki görünümü",
      "teknoloji ve medya aracılığıyla bilgi yayılımı",
      "toplumsal ve bireysel duygusal tepkilerin çeşitliliği"
    ],
    "aesthetic_cues": [
      "ağırlaşan gündelik basınç atmosferi",
      "parlayan ve tuhaflaşan sahne ışıkları",
      "yumuşayan şehir içi temas",
      "derin zaman ve bilgi kırıntıları",
      "görsel ve sözel anlatımda ritmik tekrarlar",
      "duygu ve düşünce yoğunluğunun görsel yansımaları"
    ],
    "rhythm_cues": [
      "başlık ve anahtar kelime tekrarlarıyla vurgu oluşturma",
      "duygusal ton değişimleriyle ritim sağlama",
      "kısa ve öz cümlelerle hızlı bilgi akışı",
      "konu değişimlerinde ritmik duraklamalar",
      "görsel ve sözel unsurların senkronizasyonu"
    ],
    "attention_shifts": [
      "politik haberlerden sanata geçiş",
      "şiddet ve psikoloji arasındaki geçiş"
    ],
    "image_expansion_candidates": [
      "politik gerilimlerin haritaları ve ilişkiler ağı",
      "saldırı ve afet sahnelerinin görselleştirilmesi",
      "psikolojik durumların metaforik anlatımları",
      "şehir yaşamı ve oyun temalarının renkli tasvirleri"
    ],
    "sentence_moves": [
      "gündemdeki politik olayların etkilerini özetleme",
      "şiddet olaylarının sonuçlarını anlatma",
      "bireylerin ve kurumların duygu ve güven ilişkilerini açıklama",
      "sanat ve kültür etkinliklerinin önemini vurgulama",
      "insanlık tarihinden bilimsel bulguları aktarma",
      "psikolojik durumların belirtilerini tanımlama",
      "toplumsal etkinliklerin atmosferini betimleme",
      "şehir yaşamındaki değişimleri ve oyun deneyimlerini tarif etme"
    ],
    "internalized_effect": [
      "sanat ve kültürle gelen umut ve arzu duygusu",
      "psikolojik durumların içselleştirilmesiyle empati",
      "toplumsal olayların bireyde yarattığı dikkat ve duyarlılık",
      "ışık ve ses oyunlarıyla duygusal yoğunluk artışı"
    ],
